// Mobile preview toggle (matomas tik desktop'e)
function toggleMobilePreview() {
  document.body.classList.toggle('full-mobile-preview');
  const btn = document.getElementById('mobile-preview-toggle');
  if (btn) {
    if (document.body.classList.contains('full-mobile-preview')) {
